[Unit]
Description=Synchronize Sanders clock after networking is available
Wants=network-online.target
After=NetworkManager.service NetworkManager-wait-online.service network-online.target
ConditionPathExists=/usr/bin/timedatectl

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sanders-time-sync
RemainAfterExit=yes
TimeoutStartSec=70

[Install]
WantedBy=multi-user.target
