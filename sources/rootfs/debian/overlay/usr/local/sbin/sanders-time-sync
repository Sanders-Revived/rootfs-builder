#!/bin/sh
set -eu

# Sanders has no reliable battery-backed RTC. Enable timesyncd and give it a
# short opportunity to correct the clock before users run apt or SSH clients.
timedatectl set-ntp true >/dev/null 2>&1 || true

i=0
while [ "$i" -lt 30 ]; do
    synchronized="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    [ "$synchronized" = yes ] && exit 0
    sleep 2
    i=$((i + 1))
done

# Offline boots must continue; systemd-timesyncd will keep retrying in the
# background once Wi-Fi or USB networking becomes available.
exit 0
